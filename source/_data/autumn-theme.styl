/* 深秋书房 — warm-paper companion to 南瓜夜读. Select seasonalTheme: autumn. */
:root {
  --seasonal-accent: #a4522d;
  --seasonal-border: rgba(111, 118, 88, .18);
  --seasonal-shadow: rgba(79, 59, 39, .06);
  --seasonal-glow: rgba(164, 82, 45, .12);
  --body-bg-color: #f3eee5;
  --content-bg-color: #fffdf8;
  --card-bg-color: #f5eee2;
  --text-color: #38332f;
  --blockquote-color: #76685e;
  --link-color: #a4522d;
  --link-hover-color: #606947;
  --brand-color: #38332f;
  --brand-hover-color: #a4522d;
  --selection-bg: #e3c3a3;
  --selection-color: #38332f;
  --table-row-odd-bg-color: #f5eee2;
  --table-row-hover-bg-color: #ece5d8;
  --menu-item-bg-color: #f0e6d7;
  --theme-color: #f3eee5;
  --btn-default-bg: transparent;
  --btn-default-color: #a4522d;
  --btn-default-border-color: #a4522d;
  --btn-default-hover-bg: #a4522d;
  --btn-default-hover-color: #fffdf8;
  --btn-default-hover-border-color: #a4522d;
  color-scheme: light;
}

body {
  background-color: #f3eee5;
  background-image:
    radial-gradient(ellipse at 5% 0%, rgba(204, 158, 100, .12), transparent 40%),
    radial-gradient(ellipse at 95% 70%, rgba(111, 118, 88, .08), transparent 35%);
  background-attachment: fixed;
}

.headband {
  background: linear-gradient(90deg, #a9ad92, #c99a6b, #a4522d, #a9ad92);
}

header.header {
  background:
    radial-gradient(circle at 92% 8%, rgba(240, 198, 111, .2), transparent 38%),
    linear-gradient(150deg, #f7f1e6, #eee7d9);
  border: 1px solid rgba(111, 118, 88, .18);
  border-radius: 12px;
  isolation: isolate;
  overflow: hidden;
  position: relative;
}

header.header .site-brand-container,
header.header .site-nav {
  background: transparent;
  position: relative;
  z-index: 1;
}

header.header .site-meta {
  padding: 38px 20px 28px;
}

header.header .brand,
header.header .brand:hover,
header.header .menu-item a {
  color: #38332f;
}

header.header .site-title {
  letter-spacing: .08em;
}

header.header .site-subtitle,
.posts-expand .post-meta-container,
.footer,
.footer a {
  color: #76685e;
}

header.header .menu-item a:hover,
header.header .menu-item a.menu-item-active {
  background: rgba(164, 82, 45, .07);
  color: #a4522d;
}

header.header .toggle {
  color: #606947;
}

header.header .site-nav-toggle .toggle .toggle-line {
  background: #606947;
}

.posts-expand .post-title-link {
  color: #38332f;
}

.post-body h1,
.post-body h2,
.post-body h3 {
  border-bottom-color: rgba(111, 118, 88, .2);
}

.post-body blockquote {
  border-left-color: #6f7658;
}

.sidebar-nav .sidebar-nav-active,
.sidebar-nav .sidebar-nav-active:hover,
.sidebar-toc-active .sidebar-nav-toc,
.sidebar-overview-active .sidebar-nav-overview {
  border-bottom-color: #a4522d;
  color: #a4522d;
}

.site-author-image {
  border-color: #d6c1a5;
}

.pagination .page-number.current {
  background: #a4522d;
  border-color: #a4522d;
  color: #fffdf8;
}

.search-popup {
  border: 1px solid #d6c1a5;
  border-radius: 12px;
}

.search-popup .search-header {
  background: #f0e6d7;
}

.search-popup .search-icon,
.search-popup .popup-btn-close {
  color: #76685e;
}

figure.highlight {
  border: 1px solid rgba(111, 118, 88, .15);
  border-radius: 8px;
  color-scheme: light;
}

img,
img:hover {
  opacity: 1;
}

a:focus-visible,
button:focus-visible,
input:focus-visible,
[role='button']:focus-visible {
  outline: 2px solid #a4522d;
  outline-offset: 4px;
}

.autumn-visuals {
  contain: layout paint;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
  position: absolute;
  user-select: none;
  z-index: 0;
}

.autumn-leaf {
  font-size: 19px;
  line-height: 1;
  opacity: .55;
  position: absolute;
}

.autumn-leaf--near {
  left: 12px;
  top: 15px;
  transform: rotate(-25deg);
}

.autumn-leaf--far {
  bottom: 15px;
  right: 14px;
  transform: rotate(18deg);
}

.autumn-lamp {
  height: 43px;
  position: absolute;
  right: 16px;
  top: 12px;
  width: 32px;
}

.autumn-lamp::before {
  background: radial-gradient(ellipse at 50% 15%, rgba(231, 182, 92, .26), transparent 68%);
  content: '';
  height: 100px;
  left: -28px;
  position: absolute;
  top: 14px;
  width: 90px;
}

.autumn-lamp-shade {
  background: linear-gradient(110deg, #858c69, #5f6849);
  border-radius: 18px 18px 4px 4px;
  box-shadow: 0 3px 8px rgba(211, 159, 67, .25);
  height: 16px;
  left: 0;
  position: absolute;
  top: 0;
  width: 32px;
  z-index: 1;
}

.autumn-lamp-stem {
  background: #96714b;
  height: 24px;
  left: 15px;
  position: absolute;
  top: 15px;
  width: 3px;
}

.autumn-lamp-base {
  background: #96714b;
  border-radius: 50% 50% 3px 3px;
  bottom: 0;
  height: 5px;
  left: 5px;
  position: absolute;
  width: 24px;
}

.autumn-edge-leaf {
  bottom: 100px;
  font-size: 27px;
  opacity: .5;
  position: absolute;
  right: 14px;
  transform: rotate(-20deg);
}

.autumn-edge-leaf--far {
  bottom: 70px;
  font-size: 18px;
  right: 30px;
  transform: rotate(30deg);
}

@media (max-width: 991px) {
  header.header {
    border-left: 0;
    border-radius: 0 0 12px 12px;
    border-right: 0;
  }

  .autumn-lamp {
    right: 58px;
  }

  .autumn-leaf--far {
    display: none;
  }
}

@media (forced-colors: active), print {
  .autumn-visuals,
  .headband {
    display: none;
  }

  header.header,
  body {
    background: Canvas;
  }
}

@media print {
  :root {
    --content-bg-color: #fff;
    --card-bg-color: #fff;
    --text-color: #222;
    --link-color: #222;
    --blockquote-color: #444;
  }
}

@import 'seasonal-reading';
