// The native NexT button still handles scrolling; its seasonal wrapper owns
// the optional treat controls so their clicks never trigger a trip to the top.
.halloween-pumpkin-tools {
  align-items: flex-end;
  bottom: unquote('max(22px, calc(env(safe-area-inset-bottom) + 12px))');
  display: flex;
  gap: 2px;
  left: unquote('max(22px, env(safe-area-inset-left))');
  opacity: 0;
  pointer-events: none;
  position: fixed;
  transition: opacity .18s ease, visibility .18s ease;
  user-select: none;
  visibility: hidden;
  z-index: 1100;

  &.is-visible {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
  }

  button {
    box-sizing: border-box;
    cursor: pointer;
    font-family: inherit;
    -webkit-tap-highlight-color: transparent;
  }

  .back-to-top.halloween-back-to-top {
    background: transparent;
    border: 0;
    bottom: auto;
    color: #ffb86c;
    display: block;
    height: 64px;
    left: auto;
    line-height: 1;
    margin: 0;
    opacity: 1;
    padding: 0;
    position: relative;
    right: auto;
    transition: none;
    width: 56px;
  }

  .pumpkin-scroll-percent {
    display: none;
  }
}

.pumpkin-face {
  bottom: 5px;
  display: block;
  filter: drop-shadow(0 0 10px rgba(255, 169, 75, .3));
  font-size: 42px;
  font-style: normal;
  left: 4px;
  line-height: 1;
  position: absolute;
  transition: filter .2s ease, transform .2s ease;
}

.pumpkin-handle {
  border: 2px solid #a47b55;
  border-bottom: 0;
  border-radius: 50% 50% 0 0;
  height: 18px;
  left: 23px;
  position: absolute;
  top: 3px;
  width: 18px;
}

.halloween-back-to-top:hover .pumpkin-face,
.halloween-back-to-top:focus-visible .pumpkin-face,
.halloween-pumpkin-tools.is-treated .pumpkin-face {
  filter: drop-shadow(0 0 17px rgba(255, 184, 108, .65));
  transform: translateY(-2px) rotate(-5deg);
}

.halloween-back-to-top.is-jumping {
  animation: pumpkin-hop .45s ease;
}

.pumpkin-candy-toggle {
  align-items: center;
  background: #332837;
  border: 1px solid rgba(255, 184, 108, .28);
  border-radius: 50%;
  box-shadow: 0 3px 14px rgba(9, 5, 16, .2);
  color: #ffb86c;
  display: flex;
  font-size: 18px;
  height: 44px;
  justify-content: center;
  line-height: 1;
  margin: 0 0 22px;
  padding: 0;
  transition: background .2s ease, border-color .2s ease;
  width: 44px;

  &:hover,
  &[aria-expanded='true'] {
    background: #47323d;
    border-color: #ffb86c;
  }
}

.pumpkin-treat-panel {
  background: linear-gradient(145deg, #382b3b, #292231);
  border: 1px solid rgba(255, 184, 108, .35);
  border-radius: 14px;
  bottom: calc(100% + 12px);
  box-shadow: 0 12px 36px rgba(9, 5, 16, .32);
  box-sizing: border-box;
  color: #f4ede3;
  left: 0;
  padding: 16px;
  position: absolute;
  text-align: left;
  width: unquote('min(248px, calc(100vw - 44px))');

  &[hidden] {
    display: none;
  }

  &::after {
    background: #2c2433;
    border-bottom: 1px solid rgba(255, 184, 108, .35);
    border-right: 1px solid rgba(255, 184, 108, .35);
    bottom: -6px;
    content: '';
    height: 10px;
    left: 23px;
    position: absolute;
    transform: rotate(45deg);
    width: 10px;
  }

  p {
    margin: 0;
  }

  .pumpkin-top-tip {
    color: #c0b4ca;
    font-size: 11px;
    line-height: 1.5;
  }

  .pumpkin-greeting {
    color: #ffcb91;
    font-size: 17px;
    font-weight: 600;
    line-height: 1.6;
    margin-top: 5px;
  }

  .pumpkin-reply {
    color: #c8bad2;
    font-size: 12px;
    line-height: 1.6;
    margin-top: 12px;
    min-height: 20px;
  }
}

.pumpkin-treat-actions {
  display: flex;
  gap: 8px;
  margin-top: 12px;

  button {
    background: rgba(255, 184, 108, .08);
    border: 1px solid rgba(255, 184, 108, .25);
    border-radius: 8px;
    color: #ffcf9b;
    flex: 1;
    font-size: 13px;
    line-height: 1.4;
    min-height: 44px;
    padding: 8px 5px;
    white-space: nowrap;

    &:last-child {
      background: rgba(189, 147, 249, .08);
      border-color: rgba(189, 147, 249, .3);
      color: #dbc2ff;
    }

    &:hover {
      background: rgba(255, 184, 108, .18);
    }
  }
}

.pumpkin-candies {
  bottom: 28px;
  height: 0;
  left: 26px;
  pointer-events: none;
  position: absolute;
  width: 0;

  i {
    animation: pumpkin-candy-flight .95s ease-out both;
    font-size: 21px;
    font-style: normal;
    left: 0;
    line-height: 1;
    position: absolute;
    top: 0;
  }
}

@keyframes pumpkin-hop {
  45% { transform: translateY(-10px) rotate(-6deg); }
  75% { transform: translateY(-3px) rotate(3deg); }
  100% { transform: none; }
}

@keyframes pumpkin-candy-flight {
  0% { opacity: 0; transform: scale(.5); }
  15% { opacity: 1; }
  70% { opacity: 1; }
  100% {
    opacity: 0;
    transform: translate(var(--candy-x), var(--candy-y)) rotate(var(--candy-turn));
  }
}

// Keep the mobile sidebar toggle above the larger seasonal control.
@media (max-width: 991px) {
  .sidebar-toggle {
    bottom: unquote('max(106px, calc(env(safe-area-inset-bottom) + 96px))');
  }
}

@media (prefers-reduced-motion: reduce) {
  .halloween-pumpkin-tools,
  .pumpkin-face,
  .pumpkin-candy-toggle {
    transition: none;
  }

  .halloween-back-to-top.is-jumping,
  .pumpkin-candies i {
    animation: none;
  }
}

@media (forced-colors: active) {
  .pumpkin-treat-panel,
  .pumpkin-treat-actions button,
  .pumpkin-candy-toggle {
    background: Canvas;
    border-color: ButtonText;
    color: ButtonText;
  }

  .pumpkin-treat-panel p {
    color: CanvasText;
  }

  .pumpkin-treat-panel::after {
    display: none;
  }
}

@media print {
  .halloween-pumpkin-tools {
    display: none;
  }
}
