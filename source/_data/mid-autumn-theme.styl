/*
 * Mid-Autumn seasonal theme.
 * Loaded only when `midAutumnTheme: true` in the root Hexo config.
 * All decorative elements stay inside `.mid-autumn-visuals`.
 */

body {
  background-color: #111827;
  background-image:
    radial-gradient(circle at 7% 11%, rgba(238, 244, 255, .32) 0 1px, transparent 1.5px),
    radial-gradient(circle at 91% 18%, rgba(250, 235, 180, .24) 0 1px, transparent 1.5px),
    radial-gradient(circle at 14% 54%, rgba(238, 244, 255, .2) 0 1px, transparent 1.5px),
    radial-gradient(circle at 95% 67%, rgba(238, 244, 255, .22) 0 1px, transparent 1.5px),
    linear-gradient(180deg, #101827 0%, #182337 48%, #111a2a 100%);
  background-attachment: fixed;
}

.headband {
  background: linear-gradient(90deg, #273650, rgba(230, 202, 126, .72), #273650);
}

header.header {
  background:
    radial-gradient(circle at 82% 0%, rgba(246, 224, 160, .1) 0, transparent 34%),
    linear-gradient(145deg, #16243b 0%, #101a2c 58%, #1c2a42 100%);
  border: 1px solid rgba(219, 229, 245, .08);
  box-shadow: 0 8px 24px rgba(4, 10, 22, .2);
  isolation: isolate;
  overflow: hidden;
  position: relative;
}

header.header .site-brand-container,
header.header .site-nav {
  position: relative;
  z-index: 1;
}

header.header .site-brand-container {
  background: transparent;
}

header.header .brand,
header.header .brand:hover,
header.header .menu-item a {
  color: rgba(245, 248, 255, .9);
}

header.header .menu-item a:hover,
header.header .menu-item a.menu-item-active {
  background: rgba(235, 241, 255, .08);
}

header.header .site-subtitle {
  color: rgba(225, 233, 246, .76);
}

header.header .site-title {
  text-shadow: 0 0 14px rgba(255, 232, 166, .3);
}

.footer,
.footer a {
  color: rgba(224, 232, 245, .72);
}

.mid-autumn-visuals {
  contain: layout paint;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
  position: absolute;
  user-select: none;
  z-index: 0;
}

.mid-autumn-stars {
  background-image:
    radial-gradient(circle at 10% 22%, rgba(255, 249, 222, .72) 0 1px, transparent 1.4px),
    radial-gradient(circle at 25% 68%, rgba(224, 235, 255, .48) 0 1px, transparent 1.4px),
    radial-gradient(circle at 44% 17%, rgba(224, 235, 255, .38) 0 1px, transparent 1.4px),
    radial-gradient(circle at 63% 74%, rgba(255, 249, 222, .46) 0 1px, transparent 1.4px),
    radial-gradient(circle at 76% 36%, rgba(224, 235, 255, .42) 0 1px, transparent 1.4px),
    radial-gradient(circle at 93% 81%, rgba(255, 249, 222, .42) 0 1px, transparent 1.4px);
  inset: 0;
  opacity: .55;
  position: absolute;
}

.mid-autumn-moon {
  background:
    radial-gradient(circle at 31% 31%, rgba(179, 151, 84, .15) 0 7%, transparent 8%),
    radial-gradient(circle at 67% 58%, rgba(179, 151, 84, .13) 0 10%, transparent 11%),
    radial-gradient(circle at 45% 76%, rgba(179, 151, 84, .1) 0 5%, transparent 6%),
    linear-gradient(135deg, #fff9dc 0%, #f4e6ad 55%, #dfc982 100%);
  border: 1px solid rgba(255, 250, 222, .62);
  border-radius: 50%;
  box-shadow:
    0 0 14px rgba(255, 235, 170, .46),
    0 0 34px rgba(255, 224, 145, .22);
  height: 52px;
  opacity: .88;
  position: absolute;
  right: 12px;
  top: 12px;
  width: 52px;
}

.mid-autumn-cloud {
  --mid-autumn-cloud-scale: 1;
  animation: mid-autumn-cloud-drift 34s ease-in-out infinite alternate;
  backface-visibility: hidden;
  background: rgba(226, 235, 248, .24);
  border-radius: 999px;
  height: 10px;
  position: absolute;
  transform: translate3d(-6vw, 0, 0) scale(var(--mid-autumn-cloud-scale));
  width: 96px;
  will-change: transform;
}

.mid-autumn-cloud::before,
.mid-autumn-cloud::after {
  background: inherit;
  border-radius: 50%;
  content: '';
  position: absolute;
}

.mid-autumn-cloud::before {
  height: 22px;
  left: 18px;
  top: -10px;
  width: 38px;
}

.mid-autumn-cloud::after {
  height: 17px;
  right: 15px;
  top: -7px;
  width: 30px;
}

.mid-autumn-cloud--near {
  bottom: 23px;
  left: -18px;
  opacity: .38;
}

.mid-autumn-cloud--middle {
  --mid-autumn-cloud-scale: .78;
  animation-delay: -11s;
  animation-duration: 42s;
  left: 44%;
  opacity: .24;
  top: 59px;
}

.mid-autumn-cloud--far {
  --mid-autumn-cloud-scale: .6;
  animation-delay: -19s;
  animation-duration: 48s;
  bottom: 44px;
  left: 72%;
  opacity: .16;
}

@keyframes mid-autumn-cloud-drift {
  from {
    transform: translate3d(-6vw, 0, 0) scale(var(--mid-autumn-cloud-scale));
  }

  to {
    transform: translate3d(6vw, 0, 0) scale(var(--mid-autumn-cloud-scale));
  }
}

@media (max-width: 991px) {
  header.header {
    border-left: 0;
    border-right: 0;
  }

  .mid-autumn-moon {
    height: 50px;
    right: 58px;
    top: 10px;
    width: 50px;
  }

  .mid-autumn-cloud--near {
    bottom: 17px;
  }

  .mid-autumn-cloud--middle {
    left: 58%;
    top: 62px;
  }

  .mid-autumn-cloud--far {
    display: none;
  }
}

@media (max-width: 360px) {
  .mid-autumn-moon {
    height: 42px;
    right: 48px;
    width: 42px;
  }

  .mid-autumn-cloud--middle {
    opacity: .15;
  }
}

@media (prefers-reduced-motion: reduce) {
  .mid-autumn-cloud {
    animation: none;
    transform: none;
    will-change: auto;
  }
}

@media (forced-colors: active) {
  .mid-autumn-visuals {
    display: none;
  }

  body,
  header.header {
    background: Canvas;
  }

  header.header .site-title {
    text-shadow: none;
  }
}

@media print {
  .mid-autumn-visuals {
    display: none;
  }

  body,
  header.header {
    background: #fff;
  }

  header.header .site-title {
    text-shadow: none;
  }
}
